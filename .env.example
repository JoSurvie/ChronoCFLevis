# Port du serveur local ChronoCrossfit
PORT=3000

# Clé API SugarWOD (Générée dans SugarWOD > Gym Settings > Developer Keys)
# Laissez vide pour utiliser la clé saisie via l'interface ou le Mode Démo intégré
SUGARWOD_API_KEY=

# Code PIN optionnel pour protéger la modification de la clé API depuis la TV (par défaut: 0000 si vide)
ADMIN_PIN=
