# Port du serveur local ChronoCrossfit
PORT=3000

# Secret de signature des sessions d'authentification (généré automatiquement si laissé vide)
SESSION_SECRET=

# Clé API SugarWOD (Générée dans SugarWOD > Gym Settings > Developer Keys)
# Modifiable directement depuis l'interface d'administration protégée
SUGARWOD_API_KEY=
